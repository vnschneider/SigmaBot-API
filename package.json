{
  "name": "sigmabot-api",
  "version": "1.0.0",
  "main": "dist/server.js",
  "repository": "https://github.com/vnschneider/SigmaBot-API.git",
  "author": "Vinícius Schneider <mrschneider.v@gmail.com>",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "rimraf dist && tsc && copyfiles -u 1 src/infrastructure/db/models/*.graphql dist/infrastructure/db/models/",
    "start": "node dist/server.js",
    "clean": "rimraf dist",
    "faqs": "npx ts-node src/scripts/seedFAQS.ts",
    "test": "jest --watchAll",
    "lint": "eslint src --ext .ts",
    "docker:db": "docker run -d -p 27017:27017 --name mongo-sigmabot -v mongodb_data:/data/db mongo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.5.0",
    "express": "4.18.2",
    "fs": "^0.0.1-security",
    "mongoose": "^8.13.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsc": "^2.0.4",
    "typescript": "^5.8.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.2"
  }
}
